{
  // "local" | "web"
  "mode": "local",
  "local": {
    // 監視対象ディレクトリ（~ はホームディレクトリに展開される）
    "watch_dir": "/tmp/ndp",
    "dj_id": "dj-000"
  },
  "web": {
    "server_url": "http://localhost:8080"
  },
  "event_name": "Club Night vol.3",
  "show_event_name": true,
  "enable_comments": false,
  "show_tags": true,
  // 背景画像設定
  "background_image": {
    // 背景画像を格納するディレクトリ（~ 展開・相対パス解決あり）
    "base_dir": "~/apps/ndp/viewer/bg",
    // base_dir からの相対パス（null で「なし」）
    "path": "background.png"
  }
}