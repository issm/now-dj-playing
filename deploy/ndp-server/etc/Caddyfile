# ndp-server 用 Caddy 設定
# Let's Encrypt で自動 TLS 取得・更新
#
# {$DOMAIN} を sed 等で実際のドメインに置き換えてから配置すること
# 例: sed 's/{$DOMAIN}/ndp.iss.ms/' etc/Caddyfile

{$DOMAIN} {
    # アクセスログ出力（fail2ban が監視する）
    log {
        output file /var/log/caddy/access.log {
            roll_size 100MiB
            roll_keep 5
        }
        format json
    }

    reverse_proxy 127.0.0.1:8080

    # SSE 用: バッファリング無効化
    @sse path /api/sessions/*/stream
    handle @sse {
        reverse_proxy 127.0.0.1:8080 {
            flush_interval -1
        }
    }
}
