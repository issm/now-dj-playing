# ndp-server 用 Caddy 設定
# Let's Encrypt で自動 TLS 取得・更新
#
# {$DOMAIN} を sed 等で実際のドメインに置き換えてから配置すること
# 例: sed 's/{$DOMAIN}/ndp.iss.ms/' etc/Caddyfile
{$DOMAIN} {
    # アクセスログ出力（fail2ban が監視する）
    log {
        output file /var/log/caddy/access.log {
            roll_size 100MiB
            roll_keep 5
        }
        format json
    }

    # viewer-web（ブラウザ版 viewer）の静的ファイル: /v/ で配信する
    # 配置先は deploy-viewer.sh が同期する /opt/ndp-server/viewer/
    redir /v /v/
    handle_path /v/* {
        root * /opt/ndp-server/viewer
        encode zstd gzip

        # index.html はキャッシュさせない（デプロイで古いハッシュ付きファイルが消えるため）
        @html path / /index.html
        header @html Cache-Control "no-cache"

        # ファイル名にハッシュが付くアセットは長期キャッシュ
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"

        file_server
    }

    # ブラウザが自動で取りに来る favicon は 204 で応える
    # （ndp-server に中継すると 404 になり、fail2ban が連続 404 として数えて ban してしまうため）
    respond /favicon.ico 204

    reverse_proxy 127.0.0.1:8080

    # SSE 用: バッファリング無効化
    @sse path /api/sessions/*/stream
    handle @sse {
        reverse_proxy 127.0.0.1:8080 {
            flush_interval -1
        }
    }
}
