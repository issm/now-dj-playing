[Unit]
Description=ndp-server - now-dj-playing 中継サーバ
After=network.target

[Service]
Type=simple
User=ndp
Group=ndp
WorkingDirectory=/opt/ndp-server
ExecStart=/opt/ndp-server/ndp-server
Restart=on-failure
RestartSec=5

# 環境変数
Environment=RUST_LOG=info
Environment=NDP_SERVER_HOST=127.0.0.1
Environment=NDP_SERVER_PORT=8080

# セキュリティ強化
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ndp-server

[Install]
WantedBy=multi-user.target
