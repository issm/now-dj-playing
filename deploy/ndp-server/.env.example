# デプロイ設定
# このファイルを .env にコピーして値を設定してください

# Lightsail インスタンスのホスト名または IP
DEPLOY_HOST=xxx.xxx.xxx.xxx

# SSH ユーザ（Debian デフォルト: admin）
DEPLOY_USER=admin

# SSH 秘密鍵パス（省略時はデフォルトキーを使用）
DEPLOY_SSH_KEY=~/.ssh/lightsail-ndp.pem

# リモート側のインストールディレクトリ
DEPLOY_DIR=/opt/ndp-server

# ドメイン名（Caddyfile で使用）
DEPLOY_DOMAIN=relay.example.com
